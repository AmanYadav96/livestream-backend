# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
# Migrations run automatically on server start (set AUTO_MIGRATE=false to disable)
AUTO_MIGRATE=true
DB_HOST=localhost
DB_PORT=5432
DB_NAME=livestream_db
DB_USER=postgres
DB_PASSWORD=your_password

# Laravel backend — used to verify Sanctum tokens
LARAVEL_API_URL=https://trial.halobox.tv
# Streamit/Halobox token verification endpoint (must include /api prefix)
LARAVEL_USER_PATH=/api/v2/profile-details
# Comma-separated fallbacks if primary path fails (e.g. /api/user for roles)
LARAVEL_USER_FALLBACK_PATHS=/api/user,/api/profile-details
# How long (seconds) to cache a verified token in memory (default: 5 min)
TOKEN_CACHE_TTL=300
# TLS for Laravel HTTPS calls. Defaults to relaxed verification when
# LARAVEL_API_URL is https:// (fixes UNABLE_TO_VERIFY_LEAF_SIGNATURE on VPS).
# Set to false after fixing the SSL certificate chain on trial.halobox.tv.
# LARAVEL_TLS_INSECURE=false

# YouVersion Bible API
# Get your free token at: https://developers.youversion.com
# App key from https://developers.youversion.com (sent as X-YVP-App-Key)
YOUVERSION_TOKEN=your_youversion_app_key
YOUVERSION_API_BASE_URL=https://api.youversion.com/v1
# KJV (1) requires a license — default to Berean Standard Bible (3034)
YOUVERSION_DEFAULT_BIBLE_ID=111
YOUVERSION_FALLBACK_BIBLE_IDS=111,59,8,1,3034

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Trust proxy is ON by default (needed behind nginx). Set TRUST_PROXY=false to disable.
# TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20
