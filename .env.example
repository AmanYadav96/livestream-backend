# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=livestream_db
DB_USER=postgres
DB_PASSWORD=your_password

# Laravel backend — used to verify Sanctum tokens
LARAVEL_API_URL=https://trial.halobox.tv/api/
# How long (seconds) to cache a verified token in memory (default: 5 min)
TOKEN_CACHE_TTL=300

# YouVersion Bible API
# Get your free token at: https://developers.youversion.com
YOUVERSION_TOKEN=9iUWChXLoHxLna9DezEBza8Hv7MN0GMRFmtxNFFSF0nVodX3
YOUVERSION_API_BASE_URL=https://developers.youversion.com/1

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CHAT_RATE_LIMIT_MAX=20
